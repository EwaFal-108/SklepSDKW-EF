<!DOCTYPE html>
<html lang="pl">
<head>
    <title>@ViewData["Title"] - Wypożyczalnia filmów</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <link href="~/css/main.css" rel="stylesheet" />
    <style>
        .fakeimg {
            height: 200px;
            background: #aaa;
        }
        /* Delikatne odstępy dla linków w stopce */
        .shop-footer a {
            color: #fff;
            text-decoration: none;
            margin: 0 15px;
        }

            .shop-footer a:hover {
                text-decoration: underline;
            }
    </style>
</head>
<body>

    <div class="p-5 bg-primary text-white text-center">
        <h1>Wypożyczalnia Filmów VOD</h1>
        <p>Najlepsze hity kinowe w zasięgu jednego kliknięcia!</p>
    </div>

    @(await Component.InvokeAsync("Menu"))

    <div class="container mt-5">
        @RenderBody()
    </div>

    <div class="mt-5 p-4 bg-dark text-white text-center shop-footer">
        <p class="mb-0">
            <a href="@Url.Action("FooterSites", "Home", new { name = "About" })">O mnie</a>
            <a href="@Url.Action("FooterSites", "Home", new { name = "Payments" })">Metody płatności</a>
            <a href="@Url.Action("FooterSites", "Home", new { name = "Terms" })">Regulamin</a>
            <a href="@Url.Action("FooterSites", "Home", new { name = "Contact" })">Kontakt</a>
        </p>
    </div>

    @RenderSection("Scripts", required: false)
</body>
</html>