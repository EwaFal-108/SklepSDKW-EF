@model SklepSDKW_EF.Models.Film

@{
    ViewData["Title"] = "Usuwanie filmu";
}

<h1 class="text-danger">Usuwanie</h1>
<h3>Czy na pewno chcesz usunąć ten film?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Tytuł</dt>
        <dd class="col-sm-10">@Model.Title</dd>

        <dt class="col-sm-2">Reżyser</dt>
        <dd class="col-sm-10">@Model.Director</dd>

        <dt class="col-sm-2">Cena</dt>
        <dd class="col-sm-10">@Model.Price?.ToString("C")</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Tak, usuń</button>
        <a asp-action="Index" class="btn btn-secondary">Anuluj</a>
    </form>
</div>