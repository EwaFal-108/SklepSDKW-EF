@model IEnumerable<SklepSDKW_EF.Modele.Film>

@{
    ViewData["Title"] = "Lista Filmów";
}

<h1>Lista Filmów</h1>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Tytuł</th>
            <th>Reżyser</th>
            <th>Cena</th>
            <th>Kategoria</th>
            <th>Akcje</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.Director</td>
                <td>@item.Price?.ToString("0.00") zł</td>
                <td>@item.Category?.Name</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Szczegóły</a>
                </td>
            </tr>
        }
    </tbody>
</table>