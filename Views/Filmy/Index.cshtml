@model IEnumerable<SklepSDKW_EF.Models.Film>

@{
    ViewData["Title"] = "Strona główna";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="container mt-3">
    <h2 class="mb-4 text-center">Polecane filmy w naszej wypożyczalni</h2>

    <div class="row">
        @foreach (var film in Model)
        {
            <div class="col-sm-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="fakeimg text-center d-flex align-items-center justify-content-center bg-secondary text-white" style="height: 200px;">
                        <span class="fs-4 fw-bold">@film.Title</span>
                    </div>

                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <h5 class="card-title fw-bold">@film.Title</h5>
                            <p class="card-text text-muted mb-1">Reżyser: @film.Director</p>
                            <p class="card-text text-danger fw-bold">Cena: @film.Price zł</p>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                            <a href="@Url.Action("Details", "Filmy", new { filmId = film.Id })" class="btn btn-sm btn-outline-dark px-3" title="Szczegóły">
                                🔎 Zobacz
                            </a>

                            <a href="@Url.Action("AddToCart", "Cart", new { id = film.Id })" class="btn btn-sm btn-success px-3" title="Dodaj do koszyka">
                                🛒 Do koszyka
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>