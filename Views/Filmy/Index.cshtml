@model IEnumerable<SklepSDKW_EF.Modele.Film>

@{
    ViewData["Title"] = "Nasze Filmy";
}

<h1>Lista Filmów</h1>

<table class="table">
    <thead>
        <tr>
            <th>Tytuł</th>
            <th>Reżyser</th>
            <th>Cena</th>
            <th>Kategoria</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.Director</td>
                <td>@item.Price zł</td>
                <td>@item.Category.Name</td>
            </tr>
        }
    </tbody>
</table>